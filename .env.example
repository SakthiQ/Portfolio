# Copy to .env.local and fill in. Never commit .env.local.

# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the chat model
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: models to try, in order, when the main one is overloaded or out of quota
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.8-flash,gemini-3.5-flash

# Optional: raises GitHub API rate limits for the activity section (no scopes needed)
GITHUB_TOKEN=

# Optional: your deployed URL, used for SEO and Open Graph links
NEXT_PUBLIC_SITE_URL=http://localhost:3000
